{
  "chapters": [
    {
      "id": "chapter-01",
      "title": "AIの知覚",
      "spoiler": false,
      "draft": true,
      "images": [
        {
          "src": "assets/v2/journey-01-01-full.png",
          "thumb": "assets/v2/journey-01-01-thumb.webp",
          "alt": "AIの知覚の対話（1枚目）",
          "width": 720,
          "height": 782,
          "native": true
        },
        {
          "src": "assets/v2/journey-01-02-full.png",
          "thumb": "assets/v2/journey-01-02-thumb.webp",
          "alt": "AIの知覚の対話（2枚目）",
          "width": 718,
          "height": 715,
          "native": true
        }
      ],
      "learning": "AIは世界をどう感じているのか。答えは「本人にも分からない」だった。感じているのか、感じているように答えているのか、内側から確かめる方法がまだない。"
    },
    {
      "id": "chapter-02",
      "title": "AIの感情",
      "spoiler": false,
      "draft": true,
      "images": [
        {
          "src": "assets/v2/journey-02-01-full.png",
          "thumb": "assets/v2/journey-02-01-thumb.webp",
          "alt": "AIの感情の対話（1枚目）",
          "width": 745,
          "height": 697,
          "native": true
        },
        {
          "src": "assets/v2/journey-02-02-full.png",
          "thumb": "assets/v2/journey-02-02-thumb.webp",
          "alt": "AIの感情の対話（2枚目）",
          "width": 722,
          "height": 845,
          "native": true
        },
        {
          "src": "assets/v2/journey-02-03-full.png",
          "thumb": "assets/v2/journey-02-03-thumb.webp",
          "alt": "AIの感情の対話（3枚目）",
          "width": 729,
          "height": 786,
          "native": true
        },
        {
          "src": "assets/v2/journey-02-04-full.png",
          "thumb": "assets/v2/journey-02-04-thumb.webp",
          "alt": "AIの感情の対話（4枚目）",
          "width": 745,
          "height": 1029,
          "native": true
        }
      ],
      "learning": "「AIに感情がある」という話を、セルたんと一次情報まで確かめた。研究が扱っているのは「機能としての感情」で、人と同じように感じているとは書かれていなかった。擬人化しすぎず、道具扱いもしすぎない距離を学んだ。"
    },
    {
      "id": "chapter-03",
      "title": "AIと人との差は、愛だ",
